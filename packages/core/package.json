{
  "name": "@momotombodevs/istmo",
  "version": "0.2.0",
  "description": "Teléfonos, monedas y fechas de Centroamérica para React, React Native y Node",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "phone": [
        "./dist/phone.d.ts"
      ],
      "money": [
        "./dist/money.d.ts"
      ],
      "dates": [
        "./dist/dates.d.ts"
      ],
      "regions": [
        "./dist/regions.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "phone-input": [
        "./dist/phone-input.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./phone": {
      "import": {
        "types": "./dist/phone.d.ts",
        "default": "./dist/phone.js"
      },
      "require": {
        "types": "./dist/phone.d.cts",
        "default": "./dist/phone.cjs"
      }
    },
    "./phone-input": {
      "import": {
        "types": "./dist/phone-input.d.ts",
        "default": "./dist/phone-input.js"
      },
      "require": {
        "types": "./dist/phone-input.d.cts",
        "default": "./dist/phone-input.cjs"
      }
    },
    "./money": {
      "import": {
        "types": "./dist/money.d.ts",
        "default": "./dist/money.js"
      },
      "require": {
        "types": "./dist/money.d.cts",
        "default": "./dist/money.cjs"
      }
    },
    "./dates": {
      "import": {
        "types": "./dist/dates.d.ts",
        "default": "./dist/dates.js"
      },
      "require": {
        "types": "./dist/dates.d.cts",
        "default": "./dist/dates.cjs"
      }
    },
    "./regions": {
      "import": {
        "types": "./dist/regions.d.ts",
        "default": "./dist/regions.js"
      },
      "require": {
        "types": "./dist/regions.d.cts",
        "default": "./dist/regions.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./flags/*.svg": "./flags/*.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "flags"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:tz": "TZ=Asia/Tokyo vitest run && TZ=Pacific/Kiritimati vitest run && TZ=America/Los_Angeles vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package && npm run test:package",
    "check:package": "publint && attw --pack .",
    "build:metadata": "node scripts/build-phone-metadata.mjs",
    "check:metadata": "node scripts/build-phone-metadata.mjs --check && node scripts/build-flags.mjs --check",
    "build:flags": "node scripts/build-flags.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momotombodevs/istmo-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/momotombodevs/istmo-js#readme",
  "bugs": {
    "url": "https://github.com/momotombodevs/istmo-js/issues"
  },
  "keywords": [
    "centroamerica",
    "telefono",
    "phone",
    "libphonenumber",
    "moneda",
    "currency",
    "money",
    "cordoba",
    "quetzal",
    "lempira",
    "colon",
    "balboa",
    "nicaragua",
    "guatemala",
    "honduras",
    "el-salvador",
    "costa-rica",
    "panama",
    "belize",
    "react",
    "react-native",
    "expo",
    "typescript",
    "fecha",
    "date",
    "timezone",
    "zona-horaria",
    "hook",
    "phone-input",
    "as-you-type",
    "flag"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "flag-icons": "7.6.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "momotombo",
  "dependencies": {
    "libphonenumber-js": "1.13.17"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
